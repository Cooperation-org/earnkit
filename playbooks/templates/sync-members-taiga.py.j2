# Rendered by playbooks/sync-team-members.yml; fed to `manage.py shell` on
# stdin (Django exec()s piped stdin). Member data is b64-encoded JSON so no
# email or name ever needs shell/python quoting.
#
# Identity contract: mirrors get_or_create_user() in django-linkedtrust-auth's
# linkedtrust_auth/taiga_adapter.py — the LINKEDTRUST_USER_HANDLER wired in
# roles/taiga/templates/config.py.j2. That adapter finds-or-creates STRICTLY
# by email (User.objects.get(email__iexact=...); no AuthData, no OIDC sub), so
# this sync applies the same one rule with the same create conventions:
# username from the email local part ('.'/'+' -> '_', 24 chars, _N dedup),
# verified_email=True, email_token=uuid4, new_email, read_new_terms=True,
# unusable password. A member synced here and one who logs in first therefore
# converge on the SAME user — as long as their GovKit email and LinkedTrust
# email match (if they differ, first login creates a duplicate; email matching
# cannot prevent that — keep the two aligned).
#
# Idempotent: creates or attaches only. Never changes an existing membership's
# role or is_admin, never removes anything. No emails are sent (the adapter
# sends none either).
import base64
import json
import sys
import uuid

from django.apps import apps
from django.db import transaction

members = json.loads(base64.b64decode("{{ sync_members | to_json | b64encode }}"))
org_slug = json.loads(base64.b64decode("{{ sync_org_slug | to_json | b64encode }}"))
role_slug = json.loads(base64.b64decode("{{ taiga_member_role_slug | default('back') | to_json | b64encode }}"))

User = apps.get_model("users", "User")
Project = apps.get_model("projects", "Project")
Membership = apps.get_model("projects", "Membership")

project = Project.objects.filter(slug=org_slug).first()
if project is None:
    print("skip: no taiga project '%s' (add-team.yml creates it)" % org_slug)
    print("SYNC-RESULT ok changed=0 members=%d" % len(members))
    sys.exit(0)

role = project.roles.filter(slug=role_slug).first()
if role is None:
    print("SYNC-RESULT fail: project '%s' has no role slug '%s' "
          "(available: %s) — set taiga_member_role_slug to one of them"
          % (org_slug, role_slug,
             ", ".join(sorted(r.slug for r in project.roles.all())) or "none"))
    sys.exit(1)

changed = 0
with transaction.atomic():
    for m in members:
        # Same normalization as the adapter (it lowercases the OIDC email).
        email = (m["email"] or "").strip().lower()
        if not email:
            print("skip: member row without an email — nothing to match on")
            continue
        try:
            user = User.objects.get(email__iexact=email)
        except User.DoesNotExist:
            # Create conventions copied from taiga_adapter.get_or_create_user.
            base_username = email.split("@")[0].replace(".", "_").replace("+", "_")[:24]
            username = base_username
            suffix = 1
            while User.objects.filter(username__iexact=username).exists():
                username = "%s_%d" % (base_username, suffix)
                suffix += 1
            user = User(
                username=username,
                email=email,
                full_name=m.get("display_name") or email.split("@")[0],
                verified_email=True,
                email_token=str(uuid.uuid4()),
                new_email=email,
                read_new_terms=True,
            )
            user.set_unusable_password()
            user.save()
            print("changed: created taiga user %s" % email)
            changed += 1
        if Membership.objects.filter(project=project, user=user).exists():
            continue
        pending = Membership.objects.filter(project=project, user__isnull=True,
                                            email__iexact=email).first()
        if pending is not None:
            pending.user = user
            pending.save(update_fields=["user"])
            print("changed: attached %s to their pending invitation" % email)
        else:
            Membership.objects.create(project=project, user=user, role=role,
                                      is_admin=False, email=user.email)
            print("changed: added %s to project %s" % (email, org_slug))
        changed += 1

print("SYNC-RESULT ok changed=%d members=%d" % (changed, len(members)))
