#!/usr/bin/env bash
# earnkit CI/CD: refresh the custom Odoo addon checkouts and upgrade every
# custom module in every team CRM database.
#
# Called by each addon repo's GitHub Actions workflow on push (deploy ->
# ssh deploy@cohort -> sudo this script), and safe to run by hand. Takes NO
# arguments (the sudoers whitelist lists this path bare, so it must not read $@).
#
# FAIL-SAFE (2026-08-08): the code on disk must NEVER be ahead of what the team
# databases can run. A bad view aborts `odoo -u` and rolls back the schema, but
# the new source is already on disk, so the next odoo restart would load new code
# against the old schema and 500 every CRM page. So: record each addon's current
# commit, pull, upgrade every db; if ANY step fails, revert every addon checkout
# to its recorded commit and do NOT restart (the live workers keep the old code,
# which now matches disk again). Restart only after every db upgraded cleanly.
set -uo pipefail

# --- 0. serialize concurrent deploys ----------------------------------------
LOCK=/run/lock/earnkit-update-crm-addons.lock
exec 9>"$LOCK" 2>/dev/null || { LOCK=/tmp/earnkit-update-crm-addons.lock; exec 9>"$LOCK"; }
flock -w 600 9 || { echo "another update-crm-addons holds $LOCK; gave up after 600s"; exit 1; }

ODOO_USER={{ odoo_user }}
CONF={{ odoo_conf_dir }}/odoo.conf
PY={{ odoo_venv_dir }}/bin/python
ODOO_BIN={{ odoo_source_dir }}/odoo-bin
ADDONS_DIR={{ odoo_custom_addons_dir }}

# addon:branch — mirror of inventory odoo_custom_addons
ADDONS=(
{% for addon in odoo_custom_addons %}
  "{{ addon.name }}:{{ addon.branch | default('main') }}"
{% endfor %}
)
MODULES=$(IFS=,; set -- "${ADDONS[@]%%:*}"; echo "$*")

declare -A OLD_SHA
git_c() { sudo -u "$ODOO_USER" git -C "$ADDONS_DIR/$1" "${@:2}"; }

revert_all() {
  echo "!! reverting all addon checkouts to last-good (deploy failed)"
  local a name
  for a in "${ADDONS[@]}"; do
    name=${a%%:*}
    [ -n "${OLD_SHA[$name]:-}" ] && git_c "$name" reset --hard --quiet "${OLD_SHA[$name]}"
  done
}

# --- 1. record current commits, then bring each checkout to its branch tip ---
for a in "${ADDONS[@]}"; do
  name=${a%%:*}
  sha=$(git_c "$name" rev-parse HEAD 2>/dev/null) || { echo "cannot read $name HEAD"; exit 1; }
  OLD_SHA[$name]=$sha
done
for a in "${ADDONS[@]}"; do
  name=${a%%:*}; branch=${a##*:}
  echo "== fetching $name ($branch)"
  if ! { git_c "$name" fetch --quiet --prune origin && \
         git_c "$name" reset --hard --quiet "origin/$branch"; }; then
    echo "!! fetch/reset failed for $name"; revert_all; exit 1
  fi
done

# --- 2. discover the team databases (crm-<slug> owned by this install's user) -
mapfile -t DBS < <("$PY" - "$CONF" <<'PY'
import configparser, sys, psycopg2
cfg = configparser.ConfigParser(); cfg.read(sys.argv[1]); opts = cfg["options"]
conn = psycopg2.connect(host=opts["db_host"], port=opts["db_port"],
    user=opts["db_user"], password=opts["db_password"], dbname="postgres")
with conn.cursor() as cur:
    cur.execute("""SELECT d.datname FROM pg_database d
        JOIN pg_roles r ON r.oid = d.datdba
        WHERE r.rolname = %s AND d.datname ~ '^crm-[a-z0-9-]+$' ORDER BY d.datname""",
        (opts["db_user"],))
    for (name,) in cur.fetchall(): print(name)
PY
) || { echo "!! db discovery failed"; revert_all; exit 1; }

if [ "${#DBS[@]}" -eq 0 ]; then
  echo "no team CRM databases found — nothing to upgrade"; exit 0
fi

# --- 3. upgrade the custom modules in each team database --------------------
# A single failure reverts the code and stops before any restart, so disk never
# ends up ahead of a database's schema.
for db in "${DBS[@]}"; do
  echo "== upgrading $MODULES in $db"
  if ! sudo -u "$ODOO_USER" "$PY" "$ODOO_BIN" \
       -c "$CONF" -d "$db" -u "$MODULES" --stop-after-init --no-http; then
    echo "!! upgrade FAILED in $db"; revert_all
    echo "!! reverted; odoo NOT restarted (live workers keep last-good code)"; exit 1
  fi
done

# --- 4. restart (deterministic route reload) --------------------------------
systemctl restart odoo
systemctl is-active odoo
