#!/usr/bin/env bash
# earnkit CI/CD: update amebo from its repo and restart. Invoked by the
# amebo repo's GitHub Actions workflow via: sudo /opt/earnkit/bin/update-amebo
set -euo pipefail
cd /opt/amebo
sudo -u amebo git fetch origin
sudo -u amebo git reset --hard "origin/{{ amebo_branch }}"
sudo -u amebo /opt/amebo/venv/bin/pip install -q -r backend/requirements.txt
# apply any new numbered migrations (same ledger the playbook uses)
/opt/earnkit/bin/apply-amebo-migrations 2>/dev/null || true
systemctl restart amebo-backend
systemctl is-active amebo-backend

# The frontend is a Next.js STANDALONE build: the service runs
# .next/standalone/server.js, so pulling new source changes nothing until it is
# rebuilt. Without this the backend gains new routes while the dashboard keeps
# serving old pages — new endpoints answering 401 while their pages 404.
#
# Only runs where a frontend service actually exists (this VM class may be
# backend-only), and a build failure must not fail the backend deploy that has
# already succeeded above. next build leaves static/ and public/ OUT of the
# standalone bundle, so they are staged beside server.js in the same guarded
# step — a copy failure trips the same else and stops the deploy.
if systemctl list-unit-files amebo-frontend.service >/dev/null 2>&1 \
   && [ -d /opt/amebo/frontend ]; then
  echo "==> rebuilding amebo frontend"
  if sudo -u amebo bash -lc 'cd /opt/amebo/frontend && npm ci && npm run build \
       && cp -a .next/static .next/standalone/.next/ \
       && { [ -d public ] && cp -a public .next/standalone/ || true; }'; then
    systemctl restart amebo-frontend
    systemctl is-active amebo-frontend
  else
    echo "!! frontend build FAILED — backend is updated, dashboard is stale" >&2
    exit 1
  fi
fi
