#!/usr/bin/env bash
# earnkit CI/CD: update amebo from its repo and restart. Invoked by the
# amebo repo's GitHub Actions workflow via: sudo /opt/earnkit/bin/update-amebo
set -euo pipefail
cd /opt/amebo
sudo -u amebo git fetch origin
sudo -u amebo git reset --hard "origin/{{ amebo_branch }}"
sudo -u amebo /opt/amebo/venv/bin/pip install -q -r backend/requirements.txt
# apply any new numbered migrations (same ledger the playbook uses)
/opt/earnkit/bin/apply-amebo-migrations 2>/dev/null || true
systemctl restart amebo-backend
systemctl is-active amebo-backend

# Frontend: rebuild the Next.js standalone bundle from the same checkout and
# restart it. Without this the frontend drifts from main — it used to be built
# by hand, so deploys silently shipped a stale UI. npm ci pins deps to the
# lockfile; the two copies stage what `next build` leaves out of standalone.
cd /opt/amebo/frontend
sudo -u amebo npm ci
sudo -u amebo npm run build
sudo -u amebo cp -a .next/static .next/standalone/.next/
sudo -u amebo bash -c '[ -d public ] && cp -a public .next/standalone/ || true'
systemctl restart amebo-frontend
systemctl is-active amebo-frontend
