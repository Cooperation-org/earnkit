# Rendered ONCE by earnkit (roles/documenso, force: false). From then on this
# file is hand-maintained on the box: edit here, then `systemctl restart documenso`.
# Read by systemd EnvironmentFile= and by the repo's npm scripts (dotenv-cli).
# Variable names are Documenso's own (.env.example at {{ documenso_version }}).

# [[AUTH]]
NEXTAUTH_SECRET="{{ documenso_nextauth_secret }}"

# [[CRYPTO]] at least 32 characters each. Never change once documents exist.
NEXT_PRIVATE_ENCRYPTION_KEY="{{ documenso_encryption_key }}"
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY="{{ documenso_encryption_secondary_key }}"

# [[URLS]] TLS terminates at the edge; the app itself listens on loopback.
NEXT_PUBLIC_WEBAPP_URL="https://{{ documenso_domain }}"
NEXT_PRIVATE_INTERNAL_WEBAPP_URL="http://127.0.0.1:{{ documenso_http_port }}"
PORT="{{ documenso_http_port }}"

# [[DATABASE]] no pooler, so both point at the same database.
NEXT_PRIVATE_DATABASE_URL="{{ documenso_database_url }}"
NEXT_PRIVATE_DIRECT_DATABASE_URL="{{ documenso_database_url }}"

# [[SIGNING]] local .p12 created by a person (playbooks/documenso.yml step 3).
NEXT_PRIVATE_SIGNING_TRANSPORT="local"
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH="{{ documenso_signing_cert_path }}"
NEXT_PRIVATE_SIGNING_PASSPHRASE="{{ documenso_signing_passphrase }}"

# [[STORAGE]] documents stored in Postgres (Documenso's default).
NEXT_PUBLIC_UPLOAD_TRANSPORT="database"
NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT="{{ documenso_document_size_upload_limit }}"

# [[SMTP]]
NEXT_PRIVATE_SMTP_TRANSPORT="smtp-auth"
NEXT_PRIVATE_SMTP_HOST="{{ documenso_smtp_host }}"
NEXT_PRIVATE_SMTP_PORT="{{ documenso_smtp_port }}"
NEXT_PRIVATE_SMTP_SECURE="{{ documenso_smtp_secure }}"
NEXT_PRIVATE_SMTP_USERNAME="{{ documenso_smtp_user }}"
NEXT_PRIVATE_SMTP_PASSWORD="{{ documenso_smtp_password }}"
NEXT_PRIVATE_SMTP_FROM_NAME="{{ documenso_smtp_from_name }}"
NEXT_PRIVATE_SMTP_FROM_ADDRESS="{{ documenso_smtp_from_address }}"

# [[LOGIN]] LinkedTrust SSO (OIDC). Redirect URI to register on the IdP:
#   https://{{ documenso_domain }}/api/auth/callback/oidc
NEXT_PRIVATE_OIDC_WELL_KNOWN="{{ oidc_issuer }}/.well-known/openid-configuration"
NEXT_PRIVATE_OIDC_CLIENT_ID="{{ documenso_oidc_client_id }}"
NEXT_PRIVATE_OIDC_CLIENT_SECRET="{{ documenso_oidc_client_secret }}"
NEXT_PRIVATE_OIDC_PROVIDER_LABEL="{{ documenso_oidc_provider_label }}"
NEXT_PRIVATE_OIDC_SKIP_VERIFY="{{ documenso_oidc_skip_verify }}"
NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNUP="{{ documenso_disable_email_password_signup }}"

# [[BACKGROUND JOBS]] Postgres-backed queue, no Redis.
NEXT_PRIVATE_JOBS_PROVIDER="local"

# [[TELEMETRY]]
DOCUMENSO_DISABLE_TELEMETRY="{{ documenso_disable_telemetry }}"
