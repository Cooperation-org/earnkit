[Unit]
Description=amebo frontend (Next.js standalone, cohort dash chat/login pages)
After=network.target amebo-backend.service

[Service]
Type=simple
User={{ amebo_user }}
Group={{ amebo_user }}
WorkingDirectory={{ amebo_frontend_dir }}/.next/standalone
Environment=NODE_ENV=production
Environment=PORT={{ amebo_frontend_port }}
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
