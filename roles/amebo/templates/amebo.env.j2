# Managed by earnkit (roles/amebo) — edits are overwritten on the next run.
# Read twice: systemd EnvironmentFile= AND python-dotenv (load_dotenv() from
# the WorkingDirectory). Keep values unquoted; no shell expansion happens.
DATABASE_URL={{ amebo_database_url }}
API_PORT={{ amebo_api_port }}
API_HOST={{ amebo_api_host }}
ANTHROPIC_API_KEY={{ amebo_anthropic_api_key }}
{% if amebo_anthropic_base_url | default('') | length > 0 %}
ANTHROPIC_BASE_URL={{ amebo_anthropic_base_url }}
{% endif %}
# Required at startup: JWT signing for the API + Fernet key for credentials at rest.
JWT_SECRET_KEY={{ amebo_jwt_secret_key }}
ENCRYPTION_KEY={{ amebo_encryption_key }}
# Static bearer for the S2S provisioning API (/api/orgs/provision) — amebo is
# the team registry (docs/TEAM_PROVISIONING.md); govkit + add-team.yml call it.
AMEBO_S2S_TOKEN={{ amebo_s2s_token }}
# Cohort-VM credential model (Golda 2026-07-16): every team org on this VM
# intentionally runs on the VM's shared keys (one pool, no tenant boundary),
# so provisioning needs no LEGACY_ENV_ORG_ID pin. The team instance elsewhere
# keeps its legacy-pin guard; this is per-deployment.
ENV_CREDENTIALS_SHARED=true
# LinkedTrust SSO (OIDC). amebo verifies id_tokens + exchanges the auth code
# against this issuer; oidc_login.OidcConfig.from_env reads these. The
# redirect_uri must be registered at the IdP for the client or login fails with
# redirect_uri mismatch. Unset client_id -> SSO stays disabled (endpoints 401).
{% if amebo_oidc_client_id | default('') | length > 0 %}
OIDC_ISSUER={{ oidc_issuer }}
OIDC_CLIENT_ID={{ amebo_oidc_client_id }}
OIDC_CLIENT_SECRET={{ amebo_oidc_client_secret }}
OIDC_REDIRECT_URI=https://{{ amebo_domain }}/api/auth/oidc/callback
OIDC_SCOPES={{ amebo_oidc_scopes | default('openid profile email trust') }}
FRONTEND_URL=https://{{ amebo_domain }}
{% endif %}
# CORS for the cohort dash: the embed components on the workers.vc apex call
# this API with credentials (PLAN-cohort-dash.md). Unset -> the app's default
# origin list applies.
{% if amebo_cors_origins | default('') | length > 0 %}
CORS_ORIGINS={{ amebo_cors_origins }}
{% endif %}
# Origins allowed in ?next= on the OIDC login start, so the dash sign-in
# cascade can chain through amebo and return to the apex (amebo
# PLAN-cohort-dash.md, SSO-once addition). Unset -> only the FRONTEND_URL
# origin is allowed.
{% if amebo_oidc_next_allowed_origins | default('') | length > 0 %}
OIDC_NEXT_ALLOWED_ORIGINS={{ amebo_oidc_next_allowed_origins }}
{% endif %}
{% if amebo_slack_bot_token | default('') | length > 0 %}
SLACK_BOT_TOKEN={{ amebo_slack_bot_token }}
USE_EVENT_SUBSCRIPTIONS={{ 'true' if amebo_use_event_subscriptions else 'false' }}
{% endif %}
{% if amebo_slack_app_token | default('') | length > 0 %}
SLACK_APP_TOKEN={{ amebo_slack_app_token }}
{% endif %}
{% if amebo_abra_database_url | default('') | length > 0 %}
ABRA_DATABASE_URL={{ amebo_abra_database_url }}
{% endif %}
