# Managed by earnkit (roles/amebo) — edits are overwritten on the next run.
[Unit]
Description=amebo backend (FastAPI API + Slack listener + schedulers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ amebo_user }}
Group={{ amebo_user }}
WorkingDirectory={{ amebo_backend_dir }}
EnvironmentFile={{ amebo_env_file }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ amebo_venv_dir }}/bin/python -m src.main
Restart=on-failure
RestartSec=5
# amebo's shutdown completes but the process lingers (non-daemon scheduler /
# Slack threads), so a plain restart hangs in deactivating for systemd's 90s
# default = 90s of 502 on every deploy. Kill the group after 20s instead.
TimeoutStopSec=20
KillMode=mixed
MemoryMax={{ amebo_memory_max }}
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
