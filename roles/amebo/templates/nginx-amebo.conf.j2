# {{ ansible_managed }}
server {
    listen 80;
    server_name {{ amebo_domain }};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # amebo API + server-owned paths -> FastAPI backend
    location /api     { proxy_pass http://127.0.0.1:{{ amebo_api_port }}; }
    location /embed   { proxy_pass http://127.0.0.1:{{ amebo_api_port }}; }
    location /claws   { proxy_pass http://127.0.0.1:{{ amebo_api_port }}; }
    location /connect { proxy_pass http://127.0.0.1:{{ amebo_api_port }}; }
    location /health  { proxy_pass http://127.0.0.1:{{ amebo_api_port }}; }

    # Everything else (/, /chat, /login, /dashboard, /_next, ...) ->
    # the Next.js standalone frontend (amebo-frontend.service).
    location / {
        proxy_pass http://127.0.0.1:{{ amebo_frontend_port }};
        proxy_http_version 1.1;
    }
}
