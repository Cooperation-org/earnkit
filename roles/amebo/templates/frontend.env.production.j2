# {{ ansible_managed }}
# Build-time config for the Next.js frontend. NEXT_PUBLIC_* vars are baked into
# the bundle by `next build`, so this file must exist BEFORE the build task or
# the client falls back to api.ts's http://localhost:8000 default — which, in a
# real browser, points at the user's own machine and breaks every API call
# (including the login/auth check, causing an SSO redirect loop).
NEXT_PUBLIC_API_URL=https://{{ amebo_domain }}
NEXT_PUBLIC_DEFAULT_INSTANCE={{ amebo_default_instance | default('') }}
