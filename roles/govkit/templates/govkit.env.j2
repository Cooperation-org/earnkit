# Managed by earnkit (roles/govkit) — edits are overwritten on the next run.
# Read twice: django-environ (BASE_DIR/.env) AND systemd EnvironmentFile=.
# Keep values unquoted; variable NAMES are exactly what config/settings.py reads.
DEBUG=0
SECRET_KEY={{ govkit_secret_key }}
# Fernet key for task-source API tokens at rest (distinct from SECRET_KEY).
GOVKIT_SECRET_KEY={{ govkit_fernet_key }}
DATABASE_URL={{ govkit_database_url }}
# Loopback names are required: the workersvc doorway resolves invites S2S over
# http://127.0.0.1:{{ govkit_http_port }}, so the Host header is 127.0.0.1 —
# without it Django returns 400 DisallowedHost and the doorway shows
# "can't reach the accelerator".
ALLOWED_HOSTS={{ govkit_domain }},127.0.0.1,localhost
# The dash embeds + the /signin/ cascade issue cross-origin POSTs from the
# workers.vc apex, so the apex must be a trusted CSRF origin alongside govkit's
# own domain. Apex only — the site never uses a www host.
CSRF_TRUSTED_ORIGINS=https://{{ govkit_domain }},https://{{ workersvc_domain }}
# Dedicated hostname — no path prefix.
BASE_PATH=
# Doorway S2S API (invite resolve/committed) — same token in the workersvc
# env; empty disables the endpoints (every call 401s).
GOVKIT_S2S_TOKEN={{ govkit_s2s_token }}
# amebo team registry (org provisioning on invite accept) — same VM, loopback.
AMEBO_BASE_URL=http://127.0.0.1:{{ amebo_api_port }}
# The workersvc doorway's loopback API (pending walk-ups → attention feed).
DOORWAY_API_URL=http://127.0.0.1:{{ workersvc_http_port }}
AMEBO_S2S_TOKEN={{ amebo_s2s_token }}
# Where invite links GovKit mints point (the workersvc doorway on the apex).
DOORWAY_BASE_URL=https://{{ workersvc_domain }}/i/
# LinkedTrust OIDC (default login).
LINKEDTRUST_URL={{ oidc_issuer }}
LINKEDTRUST_CLIENT_ID={{ govkit_oidc_client_id }}
LINKEDTRUST_CLIENT_SECRET={{ govkit_oidc_client_secret }}
# CORS for the cohort dash: components on the workers.vc apex fetch this API
# with credentials (PLAN-cohort-dash.md). Comma-separated origins; empty
# disables cross-origin API access. Read by settings once govkit adds
# django-cors-headers (govkit plan item 1); inert before that.
CORS_ALLOWED_ORIGINS={{ govkit_cors_origins }}
# The org that is the accelerator itself. Turns on its cohort-wide Activity
# rail, opens the mentors page to its admins, and keeps it out of the ventures
# list. Empty leaves all three off.
ACCELERATOR_ORG_SLUG={{ govkit_accelerator_org_slug }}
# Hosts allowed in an absolute https ?next= after LinkedTrust login, so the
# dash sign-in cascade can round-trip back to the apex (govkit
# PLAN-cohort-dash.md item 6). Hostnames, not origins. Unset -> only
# same-site relative next paths are honored.
{% if govkit_login_next_allowed_hosts | default('') | length > 0 %}
LOGIN_NEXT_ALLOWED_HOSTS={{ govkit_login_next_allowed_hosts }}
{% endif %}
# The cohort's thin cross-app menu, served by the doorway.
COHORT_NAV_SRC=https://{{ workersvc_domain }}/static/embed/cohort-nav.js
# Cohort front door: URL template for the per-org connect page on the apex.
# The {org_slug} placeholder is LITERAL here — govkit substitutes it, not
# jinja. Var name COHORT_FRONT_DOOR agreed in the cohort-dash follow-up; the
# govkit side is landing in parallel (not yet in its .env.sample as of
# 2026-07-20) — inert until govkit reads it. Unset omits the line.
{% if govkit_cohort_front_door | default('') | length > 0 %}
COHORT_FRONT_DOOR={{ govkit_cohort_front_door }}
{% endif %}
# Pool accepts (kind=pool, screened applicants — no org) land on the dash too:
# every invite path sends people to the dash, never a GovKit page (golda 7-21).
COHORT_POOL_LANDING={{ workersvc_dashboard_url }}
# Where a team's public join page lives, so the setup screen can show the team
# the exact link they share. The page itself is workers.vc's, not GovKit's.
VENTURE_PAGE_BASE_URL=https://{{ workersvc_domain }}/ventures
# Public base for URLs relayed via servers to invitee browsers (S2S payloads).
PUBLIC_BASE_URL=https://{{ govkit_domain }}
{% if govkit_smtp_host | default('') | length > 0 %}
# Outbound mail (venture-interest notifications). Present only when the
# inventory sets govkit_smtp_host; absent, GovKit sends nothing by design.
EMAIL_HOST={{ govkit_smtp_host }}
EMAIL_PORT={{ govkit_smtp_port }}
EMAIL_HOST_USER={{ govkit_smtp_user }}
EMAIL_HOST_PASSWORD={{ govkit_smtp_password }}
DEFAULT_FROM_EMAIL={{ govkit_email_from }}
{% endif %}
