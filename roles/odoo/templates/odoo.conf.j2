# Managed by earnkit (roles/odoo) — do not edit by hand; changes are overwritten.
[options]
; ---- database (external Postgres — the VM runs no database) ----
db_host = {{ database_host }}
db_port = {{ database_port }}
db_user = {{ odoo_db_user }}
db_password = {{ odoo_db_password }}
; multitenant: one database per team, selected by request hostname.
; with the default '^%d$', crm-<team>.{{ cohort_domain }} maps to DB crm-<team>.
dbfilter = {{ odoo_dbfilter }}
; database manager UI (keep False; add-team.yml provisions team DBs)
list_db = {{ 'True' if odoo_list_db else 'False' }}

; ---- master password (database management operations) ----
admin_passwd = {{ odoo_admin_password }}

; ---- paths ----
data_dir = {{ odoo_data_dir }}
addons_path = {{ odoo_source_dir }}/addons,{{ odoo_custom_addons_dir }}

; ---- server-wide modules (loaded for EVERY database, no per-DB install) ----
; crm_force_sso: an unauthenticated GET /web/login on a team CRM host 302s
; straight to the single enabled LinkedTrust provider (no password form). It is
; controller-only (no models), so loading it server-wide is safe on every
; crm-<team> DB — current and future — with zero per-team setup.
; Repo: github.com/Cooperation-org/odoo-crm-force-sso, checked out into
; {{ odoo_custom_addons_dir }}/crm_force_sso.
server_wide_modules = base,web,crm_force_sso

; ---- http ----
; localhost only: the VM's nginx proxies from port 80.
http_interface = 127.0.0.1
http_port = {{ odoo_http_port }}
gevent_port = {{ odoo_gevent_port }}
proxy_mode = True

; ---- workers & limits (small on purpose: shared cohort VM) ----
workers = {{ odoo_workers }}
max_cron_threads = {{ odoo_max_cron_threads }}
limit_memory_soft = {{ odoo_limit_memory_soft }}
limit_memory_hard = {{ odoo_limit_memory_hard }}
limit_time_cpu = {{ odoo_limit_time_cpu }}
limit_time_real = {{ odoo_limit_time_real }}

; ---- logging: stdout -> journald (no logfile) ----
log_level = info
