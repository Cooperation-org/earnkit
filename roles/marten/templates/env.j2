# earnkit-managed build configuration for marten
VITE_API_URL=https://{{ taiga_domain }}/api/v1
PUBLIC_LINKEDTRUST_URL={{ oidc_issuer }}
PUBLIC_LINKEDTRUST_CLIENT_ID={{ taiga_oidc_client_id }}
# SSO relay allowlist (build-time — a change here requires a rebuild). This is
# the ONLY cross-origin exception to Marten's same-origin login guard: it lets
# the workers.vc signin cascade (/signin/?step=3) hand off to /sso/relay.
# NEVER widen this to a wildcard or a caller-supplied origin — it must stay the
# exact workers.vc apex only.
VITE_SSO_RELAY_ORIGINS=https://{{ cohort_domain }}
# The cohort's thin cross-app menu, served by the doorway. Build-time, so a
# change here needs a marten rebuild. Without it the board is a dead end: a
# person who arrived from the dash has no link back to any other tool.
VITE_COHORT_NAV_SRC=https://{{ workersvc_domain }}/static/embed/cohort-nav.js
