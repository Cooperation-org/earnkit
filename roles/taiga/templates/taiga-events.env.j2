# {{ ansible_managed }}
# taiga-events {{ taiga_events_version }} configuration (dotenv, per upstream .env.example)
RABBITMQ_URL="{{ taiga_amqp_url }}"
WEB_SOCKET_SERVER_PORT={{ taiga_events_port }}
APP_PORT={{ taiga_events_health_port }}
# Must equal taiga-back SECRET_KEY (it verifies the back's JWTs)
SECRET="{{ taiga_secret_key }}"
ALGORITHM="HS256"
AUDIENCE=
ISSUER=
USER_ID_CLAIM="user_id"
# Valid log level values: error, warn, info, http, verbose, debug, silly
LOG_LEVEL="info"
