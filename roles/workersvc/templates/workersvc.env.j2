# Managed by earnkit (roles/workersvc) — edits are overwritten on the next run.
# Read twice: the app's .env loading (checkout root) AND systemd EnvironmentFile=.
# Keep values unquoted; variable NAMES are exactly what the app's settings read.
DEBUG=0
SECRET_KEY={{ workersvc_secret_key }}
DATABASE_URL={{ workersvc_database_url }}
ALLOWED_HOSTS={{ workersvc_domain }}
CSRF_TRUSTED_ORIGINS=https://{{ workersvc_domain }}
# GovKit doorway S2S (invite resolve + committed callback) — same VM, loopback.
GOVKIT_BASE_URL=http://127.0.0.1:{{ govkit_http_port }}
GOVKIT_ORG_SLUG={{ workersvc_govkit_org_slug }}
GOVKIT_S2S_TOKEN={{ govkit_s2s_token }}
# LinkedTrust claims backend (signed membership claims live there, not here).
LT_API={{ lt_api }}
# Where the member lands after joining.
DASHBOARD_URL={{ workersvc_dashboard_url }}
# LinkedTrust client credentials — claim POSTs authenticate so the backend
# stamps issuerId=https://workers.vc (approval claims, wall filter).
LT_CLIENT_ID={{ workersvc_lt_client_id }}
LT_CLIENT_SECRET={{ workersvc_lt_client_secret }}
# --- Cohort dash (/dash/) — PLAN-cohort-dash.md ------------------------------
# Browser-facing bases the dash template hands to each app's embed components.
# MARTEN_PUBLIC_URL follows the settings' *_PUBLIC_URL naming (workers.vc plan
# item 8); marten_domain is marten.<domain> (the animal).
GOVKIT_PUBLIC_URL=https://{{ govkit_domain }}
AMEBO_PUBLIC_URL=https://{{ amebo_domain }}
MARTEN_PUBLIC_URL=https://{{ marten_domain }}
# amebo links API, read server-side for the dash tools row — same VM, loopback.
# AMEBO_API_TOKEN is a personal amebo JWT today (empty omits the row); it will
# be replaced by an amebo API key once amebo grows service auth for
# /api/organizations/links (amebo plan item 3).
AMEBO_API_BASE=http://127.0.0.1:{{ amebo_api_port }}
AMEBO_API_TOKEN={{ workersvc_amebo_api_token }}
