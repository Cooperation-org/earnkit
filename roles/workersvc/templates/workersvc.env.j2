# Managed by earnkit (roles/workersvc) — edits are overwritten on the next run.
# Read twice: the app's .env loading (checkout root) AND systemd EnvironmentFile=.
# Keep values unquoted; variable NAMES are exactly what the app's settings read.
DEBUG=0
SECRET_KEY={{ workersvc_secret_key }}
DATABASE_URL={{ workersvc_database_url }}
ALLOWED_HOSTS={{ workersvc_domain }},www.{{ workersvc_domain }}
CSRF_TRUSTED_ORIGINS=https://{{ workersvc_domain }},https://www.{{ workersvc_domain }}
# GovKit doorway S2S (invite resolve + committed callback) — same VM, loopback.
GOVKIT_BASE_URL=http://127.0.0.1:{{ govkit_http_port }}
GOVKIT_ORG_SLUG={{ workersvc_govkit_org_slug }}
GOVKIT_S2S_TOKEN={{ govkit_s2s_token }}
# LinkedTrust claims backend (signed membership claims live there, not here).
LT_API={{ lt_api }}
# Where the member lands after joining.
DASHBOARD_URL={{ workersvc_dashboard_url }}
