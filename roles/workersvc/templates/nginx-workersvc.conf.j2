# {{ ansible_managed }}
# Workers.vc apex: the site reverse proxy (Caddy on the Proxmox host) sends
# {{ workersvc_domain }} (and www.) to this VM on :80. TLS terminates
# upstream, hence plain HTTP here and the hardcoded X-Forwarded-Proto.
# Included by the nginx role from /etc/nginx/earnkit/.

server {
    listen 80;
    listen [::]:80;
    server_name {{ workersvc_domain }} www.{{ workersvc_domain }};

    client_max_body_size {{ workersvc_max_upload_size }};
    charset utf-8;

    location / {
        proxy_pass http://127.0.0.1:{{ workersvc_http_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
